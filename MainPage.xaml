<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LAB2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">
            
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Text="Ключ"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="#FF939393"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnGenerateKey">
                
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">

                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent" />
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="White" />
                                    <Setter Property="TextColor"
                                            Value="Black" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Button>

                <Button
                    Grid.Column="1"
                    Text="Шифрование"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="#FF939393"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnPickFileClicked">

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">

                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent" />
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="White" />
                                    <Setter Property="TextColor"
                                            Value="Black" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Button>
                
                <Button
                    Grid.Column="2"
                    Text="Дешифрование"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="#FF939393"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnPickFileClicked">

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">

                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="Transparent" />
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="White" />
                                    <Setter Property="TextColor"
                                            Value="Black" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Button>

                
            </Grid>
            
            <Grid 
                ColumnDefinitions="*, *, *" 
                ColumnSpacing="10"
                RowSpacing="10"
                RowDefinitions="Auto, Auto"
                >
                <Entry
                    Grid.Row="0"
                    Grid.Column="0"
                    x:Name="KeyEntry"
                    Placeholder="Введите размер ключа(симв)"
                    Keyboard="Numeric"
                    FontSize="18"
                    TextColor="White"
                    PlaceholderColor="Gray"
                    BackgroundColor="Transparent"
                    WidthRequest="250"
                    HorizontalOptions="Center"/>

                <Button
                    Grid.Column="0"
                    Grid.Row="1"
                    Text="Сохранить"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnSaveKeyCliccked">
                </Button>

                <Button
                    Grid.Column="1"
                    Grid.Row="0"
                    Text="Ключ"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnDowloadKey">
                </Button>

                <Button
                    Grid.Column="2"
                    Grid.Row="0"
                    Text="Ключ"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnDowloadKey">
                </Button>
                <Button
                    Grid.Column="1"
                    Grid.Row="1"
                    Text="Зашифровать"
                    WidthRequest="155"
                    HeightRequest="50"
                    BackgroundColor="Red"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnEncrypt"/>

                <Button
                    Grid.Column="2"
                    Grid.Row="1"
                    Text="Расшифровать"
                    WidthRequest="160"
                    HeightRequest="50"
                    BackgroundColor="#FF03E1F1"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnDecrypt">
                </Button>
            </Grid>
            
            <Label
                    x:Name="FileName"
                    Text="Файл не выбран"
                    FontSize="18"
                    HorizontalOptions="Center"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
