<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LAB2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">
            

            <Button
                Text="Выбрать файл"
                WidthRequest="155"
                HeightRequest="50"
                BackgroundColor="Green"
                FontSize="18"
                Clicked="OnPickFileClicked"/>

            <Label
                x:Name="FileName"
                Text="Файл не выбран"
                FontSize="18"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
